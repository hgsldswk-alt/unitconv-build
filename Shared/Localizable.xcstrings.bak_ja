    "paywall.keepsData": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次打开起试用 30 天。到期后仍可换算、分享、使用已有组合和导入他人组合。试用结束不会自动扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次開啟起試用 30 天。到期後仍可換算、分享、使用現有組合和匯入他人組合。試用結束不會自動扣款。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Pro for 30 days from first launch. You can still convert, share, use existing presets and import presets after the trial. There is no automatic charge."
          }
        }
      }
    },
