    "paywall.keepsData": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次打开起试用 30 天。到期后仍可换算、分享、使用已有组合和导入他人组合。试用结束不会自动扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
